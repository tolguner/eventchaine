# Environment Variables Configuration

# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (değiştirin!)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# SUI Blockchain
NEXT_PUBLIC_SUI_NETWORK="testnet"  # mainnet, testnet, devnet
NEXT_PUBLIC_SUI_PACKAGE_ID="0x0"  # Deploy sonrası buraya package ID yazın

# Platform Wallet (Admin cüzdanı - ödemelerin gideceği adres)
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS="0x742d35cc6634c0532925a3b844bc9e7eb503ae4570b6a6babeaa7e4f0b5c0e49"

# IPFS / NFT Storage
# https://nft.storage adresinden ücretsiz API key alın
NFT_STORAGE_KEY="your-nft-storage-api-key"
NEXT_PUBLIC_NFT_STORAGE_KEY="your-nft-storage-api-key"

# Polygon (EVM) - Opsiyonel
POLYGON_MUMBAI_RPC="https://rpc-mumbai.maticvigil.com"
POLYGON_AMOY_RPC="https://rpc-amoy.polygon.technology"
PRIVATE_KEY=""  # Hardhat deploy için (0x ile başlayan private key)
NEXT_PUBLIC_POLYGON_CONTRACT_ADDRESS=""  # Contract deploy sonrası
NEXT_PUBLIC_POLYGON_CHAIN_ID="80001"  # Mumbai testnet

# Development
NODE_ENV="development"
